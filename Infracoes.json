    let currentFilter = 'todos';

    window.onload = function() {
        atualizarContador();
        renderizarInfracoes(infracoes);
    };

    function renderizarInfracoes(lista) {
        const container = document.getElementById('lista-infracoes');
        container.innerHTML = '';

        if (lista.length === 0) {
            container.innerHTML = '<div class="card"><p>Nenhuma infração encontrada.</p></div>';
            return;
        }

        lista.forEach(item => {
            const card = document.createElement('div');
            card.className = 'card';
            card.innerHTML = `
                <div class="card-header">
                    <span class="code-badge">${item.codigo}</span>
                    <span class="nature-badge ${item.natureza}">${item.natureza}</span>
                </div>
                <div class="card-title">Art. ${item.artigo} - ${item.descricao}</div>
                <div class="card-meta">
                    <span><strong>Pontos:</strong> ${item.pontos}</span>
                    <span><strong>Valor:</strong> R$ ${item.valor.toFixed(2)}</span>
                    <span><strong>Competência:</strong> ${item.competencia}</span>
                </div>
                <div class="detail-row">
                    <strong>Quando Autuar:</strong> ${item.quando_autuar || 'Conforme MBFT.'}<br>
                    <strong>Não Autuar:</strong> ${item.nao_autuar || 'N/A.'}<br>
                    <strong>Obs. Obrigatória AIT:</strong> ${item.obs_ait || 'N/A.'}
                </div>
            `;
            container.appendChild(card);
        });
    }

    function filtrarInfracoes() {
        const termo = document.getElementById('searchInput').value.toLowerCase();
        const filtradas = infracoes.filter(item => {
            const matchTermo = item.codigo.toLowerCase().includes(termo) ||
                              item.artigo.toLowerCase().includes(termo) ||
                              item.descricao.toLowerCase().includes(termo);
            
            const matchFilter = currentFilter === 'todos' || 
                               (currentFilter === 'abordagem' ? item.abordagem : item.natureza === currentFilter);

            return matchTermo && matchFilter;
        });
        renderizarInfracoes(filtradas);
    }

    function setFilter(filter, el) {
        document.querySelectorAll('.filter-chip').forEach(c => c.classList.remove('active'));
        el.classList.add('active');
        currentFilter = filter;
        filtrarInfracoes();
    }

    function switchTab(tab, el) {
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        el.classList.add('active');
        document.getElementById('tab-consulta').classList.add('hidden');
        document.getElementById('tab-ait').classList.add('hidden');
        document.getElementById('tab-' + tab).classList.remove('hidden');
    }

    function toggleCampoMode() {
        document.body.classList.toggle('mode-campo');
    }

    function atualizarContador() {
        document.getElementById('db-count').innerText = `${infracoes.length} Infrações (Parte 1)`;
    }

    function validarAIT() {
        const local = document.getElementById('ait-local').value;
        const codigo = document.getElementById('ait-codigo').value;
        const obs = document.getElementById('ait-obs').value;
        const res = document.getElementById('ait-resultado');

        if (!local || !codigo || !obs) {
            res.innerHTML = '<div style="color:var(--danger); font-weight:bold;">Preencha todos os campos obrigatórios.</div>';
            return;
        }
        res.innerHTML = '<div style="color:var(--success); font-weight:bold;">✓ Requisitos formais do Art. 280 do CTB verificados com sucesso.</div>';
    }
</script>

</body>
</html>
